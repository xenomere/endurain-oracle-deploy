# ---------- Core ----------
TZ=Europe/Skopje
ENVIRONMENT=production
DEPLOYMENT_PROFILE=production
WEB_WORKERS=2
ENDURAIN_HOST=https://CHANGEME.duckdns.org
BEHIND_PROXY=true
TRUSTED_PROXIES=172.16.0.0/12
SECRET_KEY=CHANGEME
FERNET_KEY=CHANGEME

# ---------- Database ----------
POSTGRES_USER=endurain
POSTGRES_PASSWORD=CHANGEME
POSTGRES_DB=endurain
DB_PASSWORD=CHANGEME
PGDATA=/var/lib/postgresql/data/pgdata
# REDIS_URL=redis://redis:6379/0   # only with a distributed-extras image

# ---------- Email (Brevo / Resend / any SMTP) ----------
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USERNAME=CHANGEME
SMTP_PASSWORD=CHANGEME
SMTP_FROM=endurain@CHANGEME.duckdns.org
SMTP_SECURE=false
SMTP_SECURE_TYPE=starttls

# ---------- Rate limiting / security ----------
RATE_LIMIT_ENABLED=true
SESSION_IDLE_TIMEOUT_ENABLED=true
SESSION_IDLE_TIMEOUT_HOURS=72
SESSION_ABSOLUTE_TIMEOUT_HOURS=720

# ---------- Integrations (optional) ----------
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
